# HR Software Backend - Production Environment Configuration

## Core Configuration
NODE_ENV=production
PORT=3001
LOG_LEVEL=info

## Supabase Configuration
SUPABASE_URL=https://dmhcahrmssystem.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

## Security Configuration
JWT_SECRET=your-jwt-secret-key-256-bit-minimum-length
API_SECRET=your-api-secret-key-for-internal-services
ATTENDANCE_API_TOKEN=dmhca_attendance_token_2025_secure_production

## CORS Configuration
ALLOWED_ORIGINS=https://dmhcahrms.xyz,https://www.dmhcahrms.xyz

## Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

## Database Configuration (Direct PostgreSQL if needed)
DATABASE_URL=postgresql://user:password@host:port/database

## Monitoring & Logging (Optional)
SENTRY_DSN=your-sentry-dsn-for-error-tracking
NEW_RELIC_LICENSE_KEY=your-new-relic-license-key

## Email Configuration (For notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@dmhca.com
SMTP_PASS=your-smtp-app-password